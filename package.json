{
  "name": "vaxa-production",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.local -- vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:status": "dotenv -e .env.local -- prisma migrate status",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- npx tsx prisma/seed.ts",
    "db:import-skus": "dotenv -e .env.local -- npx tsx scripts/import-sku-master-data.ts",
    "db:import-boms": "dotenv -e .env.local -- npx tsx scripts/import-production-boms.ts",
    "db:import-master": "dotenv -e .env.local -- npx tsx scripts/import-sku-master-data.ts && dotenv -e .env.local -- npx tsx scripts/import-production-boms.ts"
  },
  "prisma": {
    "seed": "dotenv -e .env.local -- npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "xlsx": "^0.18.5"
  }
}
