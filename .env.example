# Copy to .env.local and fill in your LOCAL development values.
# Never commit real credentials. .env.local is git-ignored.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Set to true on local machines to enable dev-only plan/batch deletion in the UI and scripts/cleanup-planning-data.ts
ENABLE_DEV_DATA_DELETION="false"

# Set to true to allow lot create/status/adjust mutations on /materials (V1 dev gating until RBAC)
ENABLE_MATERIALS_ADMIN="false"

# Set to true to allow Saturday/Sunday plan items (local testing only)
ENABLE_WEEKEND_PLANNING="false"
